# Local, self-hosted Langfuse for development tracing (docs/PLAN.md §12). Not required to run the app.
#
# Setup (once):
#   cp langfuse/.env.example langfuse/.env      # then fill every <...> (e.g. `openssl rand -hex 32`)
#   docker compose -f langfuse/docker-compose.yml up -d    # UI on http://localhost:3000 after ~1-3 min
# Then, in the project's .env:
#   LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY = the two LANGFUSE_INIT_PROJECT_* keys below
#   LANGFUSE_BASE_URL=http://localhost:3000
# Run traced:  uv run python analyze_pr.py --pr pr_input.json --output code_review_output.json
# Stop:        docker compose -f langfuse/docker-compose.yml down     (add -v to delete all trace data)
#
# docker-compose.yml is Langfuse's official file, unmodified (github.com/langfuse/langfuse, main).
# Every value it marks CHANGEME is overridden here. Never commit langfuse/.env.

SALT=<random>
ENCRYPTION_KEY=<64 hex chars: openssl rand -hex 32>
NEXTAUTH_SECRET=<random>
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false

POSTGRES_PASSWORD=<pg-password>
DATABASE_URL=postgresql://postgres:<pg-password>@postgres:5432/postgres
CLICKHOUSE_PASSWORD=<random>
REDIS_AUTH=<random>
# MinIO's root password is also the S3 secret Langfuse uses: keep all four equal.
MINIO_ROOT_PASSWORD=<minio-password>
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<minio-password>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<minio-password>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<minio-password>

# Headless init: creates the login user, org, project and API keys on first start.
LANGFUSE_INIT_ORG_ID=local-dev
LANGFUSE_INIT_ORG_NAME=Local Dev
LANGFUSE_INIT_PROJECT_ID=pr-review
LANGFUSE_INIT_PROJECT_NAME=PR Review Assistant
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<random>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<random>
LANGFUSE_INIT_USER_EMAIL=dev@langfuse.local
LANGFUSE_INIT_USER_NAME=dev
LANGFUSE_INIT_USER_PASSWORD=<random>
