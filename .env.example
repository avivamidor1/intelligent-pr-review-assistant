# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=

# Optional: Jev decision model for routing the uncertain middle.
# Without it, the router uses rules only and sends uncertain PRs to "complex".
# When set, PR content is sent to Jev.
JEV_API_KEY=

# Optional overrides (defaults live in config.py)
# MODEL_MAIN=claude-opus-5-5
# JEV_THRESHOLD=0.85

# Optional, development only: Langfuse tracing (requires the `dev` dependency group).
# Tracing is enabled only when both keys are set.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
