# Copy to .env and fill in. Never commit .env.

# Required
ANTHROPIC_API_KEY=

# Optional: Jev (TypeSafe) decision model for routing the uncertain middle. A TypeSafe API key.
# Without it, the router uses rules only and sends uncertain PRs to "complex".
# When set, the content of uncertain-middle PRs only (small code changes) is sent to Jev.
JEV_API_KEY=

# Optional overrides (defaults live in config.py)
# MODEL_MAIN=claude-opus-5-5
# JEV_THRESHOLD=0.85   # P(simple) needed to route simple; must be in [0.5, 1.0]

# Optional, development only: Langfuse tracing (requires the `dev` dependency group).
# Tracing is enabled only when both keys AND the base URL are set (no URL = no tracing,
# never a silent default to Langfuse Cloud). The local server is in langfuse/
# (see langfuse/.env.example); the keys are its LANGFUSE_INIT_PROJECT_* keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
